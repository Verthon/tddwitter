{
  "name": "tddwitter",
  "version": "1.0.0",
  "private": true,
  "description": "TDDwitter - A Twitter clone built with TDD",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "check": "node scripts/check-locks.mjs && pnpm -r --workspace-concurrency=1 check",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.14.0"
}
