{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "db:migrate": "node-pg-migrate up --migrations-dir db/migrations",
    "db:seed": "tsx db/seed.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm type-check && pnpm test:unit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.6",
    "bcrypt": "6.0.0",
    "date-fns": "4.1.0",
    "hono": "4.11.3",
    "pg": "8.17.2",
    "postgres": "3.4.8",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/node": "24.10.4",
    "node-pg-migrate": "8.0.4",
    "oxfmt": "0.26.0",
    "oxlint": "1.41.0",
    "tsx": "4.21.0",
    "typescript": "5.8.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.0.16"
  }
}
